[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = "*"
uvicorn = {extras = ["standard"], version = "*"}
pydantic = "*"
aiosqlite = "*"
python-multipart = "*"
sqlalchemy = {extras = ["asyncio"], version = "*"}
alembic = "*"
psycopg2-binary = "*"
asyncpg = "*"
aiofiles = "*"
h5py = "*"
httpx = "*"
python-dotenv = "*"

[dev-packages]
pytest = "*"
