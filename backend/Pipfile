[scripts]
# เปิด LAN / อุปกรณ์อื่นเรียก API ที่ IP เครื่อง: ต้อง host 0.0.0.0 (ไม่ใช่ค่าเริ่มต้น 127.0.0.1)
dev = "uvicorn main:app --host 0.0.0.0 --port 8000 --reload"
