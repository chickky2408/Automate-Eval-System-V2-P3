[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = "*"
uvicorn = {extras = ["standard"], version = "*"}
pydantic = "*"
aiosqlite = "*"
python-multipart = "*"
sqlalchemy = {extras = ["asyncio"], version = "*"}
alembic = "*"
psycopg2-binary = "*"
asyncpg = "*"
aiofiles = "*"
h5py = "*"
httpx = "*"
python-dotenv = "*"
paramiko = "*"

[dev-packages]
pytest = "*"
httpx = "*"

[requires]
python_version = "3.11"

[scripts]
# Host 0.0.0.0 to allow access from other devices in local network (default 127.0.0.1)
dev = "uvicorn main:app --host 0.0.0.0 --port 8000 --reload"
