# Copy to .env and restart `npm run dev`.
#
# Recommended for local dev (see vite.config.js proxy):
#   VITE_API_BASE_URL=/api
# Browser calls http://localhost:5173/api/... → Vite forwards to http://127.0.0.1:8000/api/...
# Avoids "Load failed" when .env used a LAN URL but only localhost:8000 was listening.
#
# Phone / another PC on Wi‑Fi (no proxy): full URL to your Mac + backend must bind 0.0.0.0:
#   VITE_API_BASE_URL=http://<LAN-IP>:8000/api
#
VITE_API_BASE_URL=/api
