<mxfile host="app.diagrams.net" agent="Mozilla/5.0" version="24.0.0"><diagram id="diag_master_arch" name="Master Backend Architecture"><mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1400"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="10" value="🌐 1. PRESENTATION &amp; CLIENT LAYER" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#1e293b;strokeColor=#475569;fontColor=#ffffff;rounded=1;arcSize=10;" parent="1" vertex="1"><mxGeometry x="40" y="40" width="2320" height="160" as="geometry" /></mxCell><mxCell id="11" value="" style="swimlane;startSize=0;horizontal=0;fillColor=none;strokeColor=none;collapsible=0;" parent="10" vertex="1"><mxGeometry x="0" y="30" width="2320" height="130" as="geometry" /></mxCell><mxCell id="12" value="&lt;b&gt;🖥️ React Dashboard UI&lt;/b&gt;&lt;br/&gt;• High-Speed Waveform Scope (60fps)&lt;br/&gt;• Fleet Manager &amp; Multi-Artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#3b82f6;fontColor=#93c5fd;fontSize=11;" parent="11" vertex="1"><mxGeometry x="40" y="20" width="320" height="80" as="geometry" /></mxCell><mxCell id="13" value="&lt;b&gt;💻 WebSSH Terminal (xterm.js)&lt;/b&gt;&lt;br/&gt;• Paramiko WebSocket Tunnel&lt;br/&gt;• Hardware Telemetry Gauge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#10b981;fontColor=#6ee7b7;fontSize=11;" parent="11" vertex="1"><mxGeometry x="420" y="20" width="300" height="80" as="geometry" /></mxCell><mxCell id="14" value="&lt;b&gt;📱 KV/KR Local WebApp&lt;/b&gt;&lt;br/&gt;• Port 8000 WebUI&lt;br/&gt;• Standalone Control &amp; Status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#f59e0b;fontColor=#fde68a;fontSize=11;" parent="11" vertex="1"><mxGeometry x="1600" y="20" width="300" height="80" as="geometry" /></mxCell><mxCell id="15" value="&lt;b&gt;⌨️ Local CLI / cURL API&lt;/b&gt;&lt;br/&gt;• Direct LAN Automation&lt;br/&gt;• Standalone Trigger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#8b5cf6;fontColor=#ddd6fe;fontSize=11;" parent="11" vertex="1"><mxGeometry x="1960" y="20" width="280" height="80" as="geometry" /></mxCell><mxCell id="20" value="🏢 2. V2 CENTRAL MANAGEMENT PLATFORM (FastAPI Backend - Port 8000)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#0f172a;strokeColor=#334155;fontColor=#ffffff;rounded=1;arcSize=10;" parent="1" vertex="1"><mxGeometry x="40" y="260" width="1100" height="1000" as="geometry" /></mxCell><mxCell id="21" value="" style="swimlane;startSize=0;horizontal=0;fillColor=none;strokeColor=none;collapsible=0;" parent="20" vertex="1"><mxGeometry x="0" y="30" width="1100" height="970" as="geometry" /></mxCell><mxCell id="22" value="API Gateway &amp; Ingress Routers (/api)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#3b82f6;fontColor=#60a5fa;fontStyle=1;fontSize=13;" parent="21" vertex="1"><mxGeometry x="30" y="20" width="1040" height="40" as="geometry" /></mxCell><mxCell id="23" value="&lt;b&gt;routers/boards.py&lt;/b&gt;&lt;br/&gt;• Board Fleet CRUD&lt;br/&gt;• WebSSH Tunnel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1e2e;strokeColor=#475569;fontColor=#e2e8f0;fontSize=10;" parent="21" vertex="1"><mxGeometry x="30" y="70" width="190" height="60" as="geometry" /></mxCell><mxCell id="24" value="&lt;b&gt;routers/jobs.py&lt;/b&gt;&lt;br/&gt;• Create / Cancel Jobs&lt;br/&gt;• Priority Queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1e2e;strokeColor=#475569;fontColor=#e2e8f0;fontSize=10;" parent="21" vertex="1"><mxGeometry x="240" y="70" width="190" height="60" as="geometry" /></mxCell><mxCell id="25" value="&lt;b&gt;routers/agent_results.py&lt;/b&gt;&lt;br/&gt;• /v1/upload/init|part|comp&lt;br/&gt;• /v1/upload/stream (LZ4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1e2e;strokeColor=#475569;fontColor=#e2e8f0;fontSize=10;" parent="21" vertex="1"><mxGeometry x="450" y="70" width="200" height="60" as="geometry" /></mxCell><mxCell id="26" value="&lt;b&gt;routers/files.py&lt;/b&gt;&lt;br/&gt;• Bitstreams Library&lt;br/&gt;• Test Vectors (.bin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1e2e;strokeColor=#475569;fontColor=#e2e8f0;fontSize=10;" parent="21" vertex="1"><mxGeometry x="670" y="70" width="190" height="60" as="geometry" /></mxCell><mxCell id="27" value="&lt;b&gt;routers/ws.py&lt;/b&gt;&lt;br/&gt;• Live WebSocket&lt;br/&gt;• Event Broadcast" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1e2e;strokeColor=#475569;fontColor=#e2e8f0;fontSize=10;" parent="21" vertex="1"><mxGeometry x="880" y="70" width="190" height="60" as="geometry" /></mxCell><mxCell id="30" value="&lt;b&gt;⚙️ JobQueueService (services/job_queue.py)&lt;/b&gt;&lt;br/&gt;• Background Worker Loop (_execute_target)&lt;br/&gt;• State Transitions: pending ➔ configuring ➔ running ➔ completed&lt;br/&gt;• Automatic Board Dispatch &amp; Timeout Handling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#6366f1;fontColor=#c7d2fe;fontSize=11;align=left;spacingLeft=15;" parent="21" vertex="1"><mxGeometry x="30" y="150" width="1040" height="80" as="geometry" /></mxCell><mxCell id="31" value="&lt;b&gt;📡 BoardManager &amp; Watchdog (services/board_manager.py)&lt;/b&gt;&lt;br/&gt;• Heartbeat Registry (15s Window) &amp; Telemetry Tracker&lt;br/&gt;• Watchdog Sweeper (30s Timeout detection ➔ Sets offline)&lt;br/&gt;• execute_job() &amp; Force Reboot API Handler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#10b981;fontColor=#a7f3d0;fontSize=11;align=left;spacingLeft=15;" parent="21" vertex="1"><mxGeometry x="30" y="250" width="1040" height="80" as="geometry" /></mxCell><mxCell id="32" value="&lt;b&gt;📁 FileStoreService &amp; Artifact Registrar (services/file_store.py)&lt;/b&gt;&lt;br/&gt;• SHA-256 Checksum Verification &amp; Multi-Format Storage&lt;br/&gt;• Automatic .tar.gz Unpacker &amp; Database Linker&lt;br/&gt;• Directories: uploads/WAVEFORM, uploads/REPORT, uploads/LOG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f59e0b;fontColor=#fde68a;fontSize=11;align=left;spacingLeft=15;" parent="21" vertex="1"><mxGeometry x="30" y="350" width="1040" height="80" as="geometry" /></mxCell><mxCell id="33" value="&lt;b&gt;📈 WaveformEngine (services/waveform_file.py)&lt;/b&gt;&lt;br/&gt;• High-Speed HDF5 Slicer (Dataset 'raw', int16 samples)&lt;br/&gt;• Server-Side Multi-Threaded VCD Generator (0.1s)&lt;br/&gt;• Sub-sampling for 60fps WebGL/Canvas Viewport" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#ec4899;fontColor=#fbcfe8;fontSize=11;align=left;spacingLeft=15;" parent="21" vertex="1"><mxGeometry x="30" y="450" width="1040" height="80" as="geometry" /></mxCell><mxCell id="34" value="&lt;b&gt;🔒 WebSSH Proxy Service&lt;/b&gt;&lt;br/&gt;• Paramiko SSH Client (Port 22 Keepalives)&lt;br/&gt;• Incremental UTF-8 Stream Decoder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#06b6d4;fontColor=#a5f3fc;fontSize=11;align=left;spacingLeft=15;" parent="21" vertex="1"><mxGeometry x="30" y="550" width="1040" height="70" as="geometry" /></mxCell><mxCell id="40" value="&lt;b&gt;🗄️ PostgreSQL Database&lt;/b&gt;&lt;br/&gt;• boards, board_status&lt;br/&gt;• jobs, test_cases, run_sets&lt;br/&gt;• results, files" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#1e293b;strokeColor=#3b82f6;fontColor=#bfdbfe;fontSize=11;" parent="21" vertex="1"><mxGeometry x="100" y="660" width="400" height="120" as="geometry" /></mxCell><mxCell id="41" value="&lt;b&gt;💾 High-Speed NVMe Storage&lt;/b&gt;&lt;br/&gt;• uploads/WAVEFORM/{year}/{month}/*.h5&lt;br/&gt;• uploads/REPORT/*.csv&lt;br/&gt;• uploads/LOG/*.log" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#1e293b;strokeColor=#10b981;fontColor=#bbf7d0;fontSize=11;" parent="21" vertex="1"><mxGeometry x="600" y="660" width="400" height="120" as="geometry" /></mxCell><mxCell id="50" value="&lt;b&gt;🌐 GIGABIT LAN (1 Gbps) / SFP+ (10G)&lt;/b&gt;&lt;br/&gt;• REST Control: POST /execute, POST /reboot&lt;br/&gt;• 🚀 LZ4 Streaming (615.9 MB/s | ~3s for 1.5GB)&lt;br/&gt;• SSH Port 22 WebSocket Tunnel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#6366f1;fontColor=#ffffff;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1180" y="500" width="200" height="200" as="geometry" /></mxCell><mxCell id="60" value="⚡ 4. FPGA INTERFACE EDGE NODE (KR260 / KV260 / Zybo)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#022c22;strokeColor=#065f46;fontColor=#ffffff;rounded=1;arcSize=10;" parent="1" vertex="1"><mxGeometry x="1420" y="260" width="940" height="1000" as="geometry" /></mxCell><mxCell id="61" value="" style="swimlane;startSize=0;horizontal=0;fillColor=none;strokeColor=none;collapsible=0;" parent="60" vertex="1"><mxGeometry x="0" y="30" width="940" height="970" as="geometry" /></mxCell><mxCell id="62" value="Linux Processing System (PetaLinux PS - 4x ARM Cortex-A53)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;fontColor=#6ee7b7;fontStyle=1;fontSize=13;" parent="61" vertex="1"><mxGeometry x="20" y="20" width="900" height="40" as="geometry" /></mxCell><mxCell id="63" value="&lt;b&gt;🤖 board_agent Daemon (FastAPI - Port 8000 - Root)&lt;/b&gt;&lt;br/&gt;• Lifespan Loop &amp; Background Heartbeat (Every 15s)&lt;br/&gt;• Routes: /health, /execute, /system/reboot, /" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#34d399;fontColor=#ecfdf5;fontSize=11;align=left;spacingLeft=15;" parent="61" vertex="1"><mxGeometry x="20" y="70" width="900" height="60" as="geometry" /></mxCell><mxCell id="64" value="&lt;b&gt;⚙️ JobRunner Engine (runner.py)&lt;/b&gt;&lt;br/&gt;• Pipeline Execution Lock (busy flag)&lt;br/&gt;• Asset Downloader (Bitstream &amp; Vectors)&lt;br/&gt;• Zero-Copy DMA Driver Orchestrator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#10b981;fontColor=#d1fae5;fontSize=11;align=left;spacingLeft=15;" parent="61" vertex="1"><mxGeometry x="20" y="140" width="430" height="80" as="geometry" /></mxCell><mxCell id="65" value="&lt;b&gt;🚀 LZ4 Fast Streamer (615.9 MB/s)&lt;/b&gt;&lt;br/&gt;• lz4.frame RAM-to-Socket Streaming&lt;br/&gt;• Zero Disk Bottleneck on SD Card&lt;br/&gt;• 1.5 GB ➔ ~80 MB in ~2.5s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#6366f1;fontColor=#e0e7ff;fontSize=11;align=left;spacingLeft=15;" parent="61" vertex="1"><mxGeometry x="470" y="140" width="450" height="80" as="geometry" /></mxCell><mxCell id="66" value="&lt;b&gt;🔧 FpgaController &amp; Reset&lt;/b&gt;&lt;br/&gt;• xmutil / fpgautil -b Flash&lt;br/&gt;• 0xA0020000 devmem Pulse Reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#f59e0b;fontColor=#fef3c7;fontSize=10;" parent="61" vertex="1"><mxGeometry x="20" y="230" width="430" height="60" as="geometry" /></mxCell><mxCell id="67" value="&lt;b&gt;📊 System Metrics (metrics.py)&lt;/b&gt;&lt;br/&gt;• CPU Thermal (/sys/class/thermal)&lt;br/&gt;• RAM Usage &amp; FPGA Status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#38bdf8;fontColor=#e0f2fe;fontSize=10;" parent="61" vertex="1"><mxGeometry x="470" y="230" width="450" height="60" as="geometry" /></mxCell><mxCell id="68" value="&lt;b&gt;💾 SD Card (/mnt/sdcard/eval_standalone/)&lt;/b&gt;&lt;br/&gt;• pending_sync/ (manifest.json with synced=false)&lt;br/&gt;• Standalone Offline On-Demand Converter" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#022c22;strokeColor=#10b981;fontColor=#a7f3d0;fontSize=11;" parent="61" vertex="1"><mxGeometry x="20" y="300" width="900" height="70" as="geometry" /></mxCell><mxCell id="70" value="FPGA Programmable Logic (PL Hardware Layer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#701a75;strokeColor=#d946ef;fontColor=#fdf4ff;fontStyle=1;fontSize=13;" parent="61" vertex="1"><mxGeometry x="20" y="400" width="900" height="40" as="geometry" /></mxCell><mxCell id="71" value="&lt;b&gt;📡 AXI DMA Engine Controller&lt;/b&gt;&lt;br/&gt;Physical Addr: &lt;b&gt;0xA0000000&lt;/b&gt; (64 KB)&lt;br/&gt;• MM2S &amp; S2MM Channel Control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e1065;strokeColor=#a855f7;fontColor=#f3e8ff;fontSize=11;" parent="61" vertex="1"><mxGeometry x="20" y="450" width="430" height="70" as="geometry" /></mxCell><mxCell id="72" value="&lt;b&gt;📋 Scatter-Gather BD Ring&lt;/b&gt;&lt;br/&gt;Physical Addr: &lt;b&gt;0x7F000000&lt;/b&gt; (16 MB)&lt;br/&gt;• Descriptor Ring Buffer Pointers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e1065;strokeColor=#a855f7;fontColor=#f3e8ff;fontSize=11;" parent="61" vertex="1"><mxGeometry x="470" y="450" width="450" height="70" as="geometry" /></mxCell><mxCell id="73" value="&lt;b&gt;🧠 High-Speed DDR Sample RAM&lt;/b&gt;&lt;br/&gt;Physical Addr: &lt;b&gt;0x800000000&lt;/b&gt; (2 GB High-Speed Capture Buffer)&lt;br/&gt;• Zero-Copy Streaming Pipeline Direct Read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e1065;strokeColor=#c084fc;fontColor=#faf5ff;fontSize=11;align=left;spacingLeft=15;" parent="61" vertex="1"><mxGeometry x="20" y="530" width="900" height="70" as="geometry" /></mxCell><mxCell id="74" value="&lt;b&gt;🎛️ Control &amp; Reset Registers&lt;/b&gt;&lt;br/&gt;Physical Addr: &lt;b&gt;0xA0020000&lt;/b&gt;&lt;br/&gt;• Stimulus Pattern Trigger &amp; DUT Reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e1065;strokeColor=#a855f7;fontColor=#f3e8ff;fontSize=11;" parent="61" vertex="1"><mxGeometry x="20" y="610" width="430" height="60" as="geometry" /></mxCell><mxCell id="75" value="&lt;b&gt;🔌 DUT (Device Under Test)&lt;/b&gt;&lt;br/&gt;• CML High-Speed Differential&lt;br/&gt;• SPI / I2C / UART Bus Pins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#831843;strokeColor=#f43f5e;fontColor=#ffe4e6;fontSize=11;fontStyle=1;" parent="61" vertex="1"><mxGeometry x="470" y="610" width="450" height="60" as="geometry" /></mxCell><mxCell id="100" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3b82f6;strokeWidth=2;" parent="1" vertex="1" edge="1" source="12" target="22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="101" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=2;" parent="1" vertex="1" edge="1" source="13" target="34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="102" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f59e0b;strokeWidth=2;" parent="1" vertex="1" edge="1" source="14" target="63"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="103" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6366f1;strokeWidth=3;" parent="1" vertex="1" edge="1" source="22" target="50"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="104" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6366f1;strokeWidth=3;" parent="1" vertex="1" edge="1" source="50" target="63"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>