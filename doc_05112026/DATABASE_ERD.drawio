        <mxCell id="3J-y0pXZ4DpWyEFLEtU7-703" value="JobQueueService&amp;nbsp;&lt;div&gt;#1&amp;nbsp; Read Status == &#39;Pending&#39;&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;priority, created_at เพื่อกำหนดลำดับการรัน&lt;/div&gt;" style="shape=display;whiteSpace=wrap;html=1;rotation=0;" vertex="1" parent="1">
