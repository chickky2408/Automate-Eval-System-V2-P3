# Copy to .env and adjust. Used by: docker compose -f docker-compose.prod.yml
#
# Postgres password: POSTGRES_PASSWORD is applied only on first volume init. If you see
# "password authentication failed for user eval_admin", either set DB_PASS here to the
# password used when the DB volume was first created, or reset the DB (deletes data):
#   docker compose -f docker-compose.prod.yml down -v
#   docker compose -f docker-compose.prod.yml up --build -d
#
# Optional: isolate from other compose projects on the same host:
#   docker compose -p evalprod -f docker-compose.prod.yml up --build -d

# --- Database (defaults match docker-compose.prod.yml) ---
DB_USER=eval_admin
# After first `docker compose up`, keep this password stable — changing it in .env does not change Postgres data.
# If you already use a DB from this repo on 5433, reuse that password here (same as native `export DB_PASS=...`).
DB_PASS=change_me_strong_password
DB_NAME=eval_system
#
# Native backend (`pipenv run dev` in backend/) + Postgres from `make db` / docker-compose.yml:
# (Docker maps host :5433 → db:5432; compose prod overrides DB_HOST inside the app container.)
# DB_HOST=127.0.0.1
# DB_PORT=5433

# --- Web: host port (left side of 0.0.0.0:APP_PORT:8000) ---
APP_PORT=8000

# --- URL shown in container logs [STARTUP] and shared with your team ---
# On the machine that runs Docker, find your LAN IP (Wi-Fi), e.g. 192.168.1.108
# Reserve a fixed IP in the router (DHCP reservation) so this does not change.
# Teammates on the same network open this; you can use http://127.0.0.1:APP_PORT on the server itself.
#
# Example (uncomment and set your host LAN IP + port):
# APP_EXTERNAL_URL=http://192.168.1.108:8000
#
# If omitted, compose defaults to http://127.0.0.1:${APP_PORT}
#
# Browser note: http://127.0.0.1:8000 and http://localhost:5173 (Vite dev) are different
# origins — localStorage (profiles, UI prefs) is not shared. Export profile on dev and
# import on Docker, or rely on API-synced backend profiles.
#
# --- Remote demo (not on same Wi‑Fi): Cloudflare Quick Tunnel ---
# From repo root (Docker must be running; needs outbound HTTPS):
#   make prod-tunnel-up
#   make prod-tunnel-url     # prints https://....trycloudflare.com — share with team
# Anyone with the link can reach your app until you stop the stack (treat as public demo).
